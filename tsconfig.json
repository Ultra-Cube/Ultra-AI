{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@ultra-ai/ai-core": ["./platform/backend/ai-core/src"],
      "@ultra-ai/distributed": ["./platform/backend/distributed/src"],
      "@ultra-ai/blockchain": ["./platform/blockchain/src"],
      "@ultra-ai/api": ["./platform/backend/core-api/src"],
      "@ultra-ai/shared": ["./platform/shared/src"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next",
    "coverage",
    "external-integrations",
    "wsl-ai-stack"
  ]
}
