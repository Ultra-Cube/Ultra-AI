# Multi-stage build for Ultra AI Frontend
# Stage 1: Builder
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./
COPY . .

# Install dependencies
RUN npm ci

# Build the Next.js application
RUN npm run build --workspace=@ultra-ai/web

# Stage 2: Production
FROM node:20-alpine

WORKDIR /app

# Install dumb-init to handle signals properly
RUN apk add --no-cache dumb-init

# Copy package files from builder
COPY package.json package-lock.json ./

# Install only production dependencies
RUN npm ci --only=production && npm cache clean --force

# Copy built application from builder
COPY --from=builder /app/platform/frontend/.next ./platform/frontend/.next
COPY --from=builder /app/platform/frontend/public ./platform/frontend/public
COPY --from=builder /app/platform/frontend/node_modules ./platform/frontend/node_modules
COPY --from=builder /app/platform/frontend/next.config.js ./platform/frontend/
COPY --from=builder /app/platform/frontend/package.json ./platform/frontend/

# Copy shared packages if they exist
COPY platform/shared platform/shared

# Set environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Change ownership to nodejs user
RUN chown -R nodejs:nodejs /app

USER nodejs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Expose port
EXPOSE 3000

# Use dumb-init to run the application
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start the application
CMD ["npm", "--workspace=@ultra-ai/web", "start"]
