    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/jest": "^29.5.0",
    "typescript": "^5.3.3",
    "tsup": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "eslint": "^8.56.0"
  }
