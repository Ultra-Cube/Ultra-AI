# Ultra Core Bridge — environment
# Copy to .env and adjust. NEVER commit real secrets.

# Kill switch: "false" disables ALL outbound Ultra-Core traffic
# (HttpExportTarget.send throws; batches stay in the outbox).
# Default: enabled (true) for local/mock use.
ULTRA_CORE_ENABLED=true

# Read-only mode: "true" makes CoreClient refuse /v1/credits/* mutations
# even if called directly. Mutations also require approval_ref per contract.
ULTRA_CORE_READ_ONLY=true

# ultra-core-ingest base URL (mock: http://127.0.0.1:4100).
# No env default — pass baseUrl explicitly to HttpExportTarget /
# createCoreClient, e.g. ULTRA_CORE_URL=http://127.0.0.1:4100
ULTRA_CORE_URL=http://127.0.0.1:4100

# Bearer token for ingest/key-registration routes (POST /v1/ingest/batches,
# POST /v1/keys). Mock accepts any non-empty token; real service TBD (G-4.1).
UCI_INGEST_TOKEN=change-me-ingest-token

# Bearer token for read routes (GET /v1/proofs, /v1/instances/*/head,
# /v1/credits/*, /v1/registry/*, /v1/events). Falls back to UCI_INGEST_TOKEN.
UCI_ADMIN_TOKEN=change-me-admin-token

# Port for the mock server (npm run core:mock / docker compose service).
ULTRA_CORE_MOCK_PORT=4100
