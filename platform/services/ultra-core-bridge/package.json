{
  "name": "@ultra-ai/ultra-core-bridge",
  "version": "0.1.0",
  "description": "Ultra Core bridge readiness: signed, hash-chained ultra.event.v1 outbox and idempotent ExportTarget port. No blockchain features — Ultra Core interface pending owner spec (G-4.1).",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "build": "tsup src/index.ts --format esm,cjs",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ultra-ai/hermes-runtime": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
