{
  "name": "@ultra-ai/gate-os-bridge",
  "version": "0.1.0",
  "description": "Reference implementation of the Gate-OS /v1 integration contract (capabilities, environment profiles, adaptive UI spec, intents, events). Gate-OS itself is never modified.",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "build": "tsup src/index.ts --format esm,cjs",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ultra-ai/hermes-runtime": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
