{
  "name": "@ultra-ai/desktop-bridge",
  "version": "0.1.0",
  "description": "JSON-RPC bridge between the Ultra desktop shell (Code-OSS based) and the Hermes runtime",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "build": "tsup src/index.ts --format esm,cjs",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ultra-ai/engine-supervisor": "*",
    "@ultra-ai/hermes-runtime": "*",
    "@ultra-ai/zeroai-edge": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
