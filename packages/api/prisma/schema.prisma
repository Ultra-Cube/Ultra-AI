// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  domain      String?      @unique // Custom domain support
  status      TenantStatus @default(TRIAL)
  plan        TenantPlan   @default(FREE)
  
  // Subscription & Billing
  maxUsers    Int          @default(5)
  maxStorage  Int          @default(1073741824) // 1GB in bytes
  
  // Configuration
  settings    Json?        @db.JsonB
  
  // Metadata
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // Relations
  users       User[]
  
  @@index([slug])
  @@index([domain])
  @@index([status])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  
  // Multi-tenancy
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  // Relations
  events       AnalyticsEvent[]
  activities   UserActivity[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  files        File[]
  fileAccessLogs FileAccessLog[]

  @@index([email])
  @@index([role])
  @@index([tenantId])
  @@unique([email, tenantId]) // Email unique per tenant
}

enum EventType {
  PAGE_VIEW
  API_CALL
  USER_ACTION
  SYSTEM_EVENT
  ERROR
  AUTH
  SEARCH
  EXPORT
  CUSTOM
}

enum EventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum MetricType {
  COUNTER
  GAUGE
  HISTOGRAM
  SUMMARY
}

// Analytics Events - Raw event tracking
model AnalyticsEvent {
  id          String         @id @default(cuid())
  tenantId    String
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Event Information
  eventType   EventType
  eventName   String         // e.g., "user_login", "api_request", "button_click"
  severity    EventSeverity  @default(INFO)
  
  // Context
  path        String?        // URL path or route
  method      String?        // HTTP method
  statusCode  Int?           // Response status
  duration    Int?           // Duration in ms
  
  // Metadata
  metadata    Json?          @db.JsonB // Additional event data
  userAgent   String?
  ipAddress   String?
  
  // Success/Error tracking
  success     Boolean        @default(true)
  errorMessage String?
  errorStack   String?
  
  timestamp   DateTime       @default(now())
  
  @@index([tenantId])
  @@index([userId])
  @@index([eventType])
  @@index([eventName])
  @@index([timestamp])
  @@index([tenantId, timestamp])
  @@index([userId, timestamp])
}

// User Activity Tracking
model UserActivity {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Activity details
  action      String    // e.g., "created_report", "updated_settings"
  resource    String?   // Resource type (e.g., "report", "user")
  resourceId  String?   // Resource ID
  
  // Change tracking
  before      Json?     @db.JsonB
  after       Json?     @db.JsonB
  
  // Context
  ipAddress   String?
  userAgent   String?
  
  timestamp   DateTime  @default(now())
  
  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([userId, timestamp])
}

// Aggregated Metrics
model AnalyticsMetric {
  id          String     @id @default(cuid())
  tenantId    String
  
  // Metric Information
  metricType  MetricType
  metricName  String     // e.g., "active_users", "api_latency"
  
  // Values
  value       Float
  count       Int        @default(1)
  
  // Dimensions for grouping
  dimension1  String?    // e.g., "endpoint", "browser"
  dimension2  String?
  dimension3  String?
  
  // Time window
  timestamp   DateTime   @default(now())
  windowStart DateTime   // Start of aggregation window
  windowEnd   DateTime   // End of aggregation window
  
  @@index([tenantId])
  @@index([metricName])
  @@index([timestamp])
  @@index([tenantId, metricName, windowStart])
  @@unique([tenantId, metricName, dimension1, dimension2, dimension3, windowStart])
}

// System Performance Metrics
model SystemMetric {
  id          String    @id @default(cuid())
  
  // Metric details
  metricName  String    // e.g., "cpu_usage", "memory_usage", "response_time"
  value       Float
  unit        String?   // e.g., "percent", "ms", "bytes"
  
  // Context
  host        String?   // Host/server identifier
  service     String?   // Service name
  
  // Metadata
  tags        Json?     @db.JsonB
  
  timestamp   DateTime  @default(now())
  
  @@index([metricName])
  @@index([timestamp])
  @@index([service, timestamp])
}

// ============================================================================
// Notification System
// ============================================================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
  USER_ACTION
  REMINDER
  ANNOUNCEMENT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
  WEBHOOK
}

// Notifications
model Notification {
  id          String               @id @default(cuid())
  tenantId    String
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notification details
  type        NotificationType     @default(INFO)
  priority    NotificationPriority @default(NORMAL)
  status      NotificationStatus   @default(PENDING)
  
  // Content
  title       String
  message     String               @db.Text
  icon        String?
  actionUrl   String?
  actionLabel String?
  
  // Metadata
  metadata    Json?                @db.JsonB
  
  // Delivery tracking
  channels    NotificationChannel[]
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  errorMessage String?
  
  // User interaction
  isRead      Boolean              @default(false)
  readAt      DateTime?
  isArchived  Boolean              @default(false)
  archivedAt  DateTime?
  
  // Timestamps
  createdAt   DateTime             @default(now())
  expiresAt   DateTime?
  
  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead, createdAt])
  @@index([tenantId, createdAt])
}

// Notification Preferences
model NotificationPreference {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Channel preferences
  enableInApp Boolean   @default(true)
  enableEmail Boolean   @default(true)
  enablePush  Boolean   @default(false)
  enableSMS   Boolean   @default(false)
  
  // Type preferences (which notification types to receive)
  mutedTypes  NotificationType[]
  
  // Quiet hours
  quietHoursStart Int?  // 0-23 hour
  quietHoursEnd   Int?  // 0-23 hour
  quietHoursTimezone String? @default("UTC")
  
  // Frequency
  emailDigest Boolean   @default(false) // Send daily digest instead of individual emails
  digestTime  Int?      // Hour to send digest (0-23)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([userId])
  @@index([tenantId])
}

// ============================================================================
// File Storage System
// ============================================================================

enum FileStorageType {
  LOCAL        // Local file system
  S3           // Amazon S3
  GCS          // Google Cloud Storage
  AZURE        // Azure Blob Storage
}

enum FileStatus {
  ACTIVE
  ARCHIVED
  DELETED
  QUARANTINED  // Malware detected
}

// File Storage - Track all files
model File {
  id          String           @id @default(cuid())
  tenantId    String
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // File Information
  name        String
  mimeType    String           // e.g. "application/pdf"
  size        Int              // File size in bytes
  hash        String?          // SHA256 hash for deduplication
  
  // Storage
  storageType FileStorageType  @default(LOCAL)
  storageKey  String           // S3 key, local path, etc.
  storageUrl  String?          // CDN URL for public files
  
  // Status & Metadata
  status      FileStatus       @default(ACTIVE)
  isPublic    Boolean          @default(false)
  description String?          @db.Text
  metadata    Json?            @db.JsonB
  
  // Virus Scan
  virusScanStatus String?      // "pending", "clean", "infected"
  virusScanResultAt DateTime?
  
  // Versioning
  version     Int              @default(1)
  parentFileId String?         // For file versions
  
  // Timestamps
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  
  // Relations
  backups     FileBackup[]
  accessLogs  FileAccessLog[]
  
  @@index([tenantId])
  @@index([userId])
  @@index([storageType])
  @@index([status])
  @@index([hash])
  @@index([createdAt])
  @@index([tenantId, userId])
  @@index([tenantId, status])
}

// File Backups - Track file versions and backups
model FileBackup {
  id          String    @id @default(cuid())
  fileId      String
  file        File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  
  // Backup Info
  version     Int
  storageKey  String
  size        Int       // Backup size in bytes
  backupType  String    // "auto", "manual", "restore_point"
  
  // Metadata
  metadata    Json?     @db.JsonB
  
  createdAt   DateTime  @default(now())
  retentionUntil DateTime? // When to delete this backup
  
  @@unique([fileId, version])
  @@index([fileId])
  @@index([backupType])
  @@index([retentionUntil])
}

// File Access Logs - Audit file access
model FileAccessLog {
  id          String    @id @default(cuid())
  fileId      String
  file        File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tenantId    String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Access Info
  action      String    // "view", "download", "upload", "delete", "share"
  ipAddress   String?
  userAgent   String?
  
  // Result
  success     Boolean   @default(true)
  errorMessage String?
  
  createdAt   DateTime  @default(now())
  
  @@index([fileId])
  @@index([userId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@index([tenantId, userId, createdAt])
}

// Storage Quota - Track tenant storage limits
model StorageQuota {
  id          String    @id @default(cuid())
  tenantId    String    @unique
  
  // Limits
  maxBytes    Int       // Maximum storage in bytes
  maxFiles    Int       // Maximum number of files
  maxFileSize Int       // Maximum single file size
  
  // Usage
  usedBytes   Int       @default(0)
  usedFiles   Int       @default(0)
  
  // Warnings
  warningThreshold Int   @default(80) // Percentage (0-100)
  isWarning   Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([tenantId])
}

// File Status - Already defined in File schema section
