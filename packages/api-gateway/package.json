{
  "name": "@ultra-ai/api-gateway",
  "version": "0.1.0",
  "description": "AI Gateway Service - Multi-provider routing and token management",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "build": "tsup src/index.ts src/server.ts --format esm,cjs",
    "start": "node dist/server.js",
    "start:dev": "tsx src/index.ts",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ultra-ai/shared": "*",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "jose": "^6.1.3",
    "bcryptjs": "^3.0.3",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "sql.js": "^1.14.1",
    "marked": "^18.0.1",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node-forge": "^1.3.11",
    "@types/jsonwebtoken": "^9.0.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "ai",
    "gateway",
    "routing",
    "multi-provider",
    "token-management",
    "api-gateway"
  ]
}