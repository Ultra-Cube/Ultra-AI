{
  "name": "ultra-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Revolutionary distributed AI platform with natural language interface and blockchain rewards",
  "homepage": "https://github.com/Ultra-Cube/Ultra-AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ultra-Cube/Ultra-AI.git"
  },
  "bugs": {
    "url": "https://github.com/Ultra-Cube/Ultra-AI/issues"
  },
  "author": "Ultra Cube Tech <info@ucubetech.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "external-integrations/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky install",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose up",
    "docker:down": "docker-compose down",
    "db:migrate": "npm run db:migrate --workspace=@ultra-ai/api",
    "db:seed": "npm run db:seed --workspace=@ultra-ai/api",
    "docs:generate": "typedoc --out docs/api packages/**/src",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.6",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "semantic-release": "^23.0.0",
    "tsx": "^4.21.0",
    "turbo": "^1.12.0",
    "typedoc": "^0.25.7",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "chore",
          "security",
          "ci"
        ]
      ],
      "scope-enum": [
        2,
        "always",
        [
          "ai",
          "api",
          "ui",
          "distributed",
          "blockchain",
          "p2p",
          "auth",
          "db",
          "security",
          "core",
          "backend",
          "frontend",
          "docs",
          "deps",
          "gateway",
          "control-center",
          "desktop-ui"
        ]
      ]
    }
  },
  "keywords": [
    "ai",
    "artificial-intelligence",
    "distributed-computing",
    "blockchain",
    "p2p",
    "nlp",
    "machine-learning",
    "natural-language-processing",
    "rewards-system",
    "cryptocurrency"
  ]
}
