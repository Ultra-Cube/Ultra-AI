# Database Configuration
DATABASE_URL=postgresql://ultra_ai_user:ultra_ai_dev_password@localhost:5432/ultra_ai_db
MONGO_URL=mongodb://ultra_ai_user:ultra_ai_dev_password@localhost:27017/ultra_ai_db?authSource=admin

# Cache Configuration
REDIS_URL=redis://:ultra_ai_dev_password@localhost:6379

# API Configuration
PORT=5555
NODE_ENV=development
LOG_LEVEL=debug

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5555

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5555
NEXT_PUBLIC_WS_URL=ws://localhost:5555

# S3/File Storage Configuration
S3_BUCKET=ultra-ai-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=http://localhost:9000

# IPFS Configuration
IPFS_GATEWAY_URL=http://localhost:8080
IPFS_API_URL=http://localhost:5001

# Email Configuration (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@ultraai.com

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Feature Flags
ENABLE_GRAPHQL=true
ENABLE_WEBHOOKS=true
ENABLE_ANALYTICS=true
ENABLE_FILE_STORAGE=true
ENABLE_AUDIT_LOG=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=604800000

# External Services
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# Database Pools
DB_POOL_MIN=2
DB_POOL_MAX=10

# Cache TTL (in seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400
